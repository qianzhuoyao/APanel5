{
  "name": "@arronqzy/blueprint-dsl",
  "version": "1.0.13",
  "description": "Abuilder blueprint DSL runtime",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist",
    "readme.md"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "pnpm run typecheck && tsup",
    "dev": "tsup --watch"
  },
  "dependencies": {
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@arronqzy/eslint-config": "workspace:*",
    "@arronqzy/typescript-config": "workspace:*",
    "eslint": "^8.57.0",
    "tsup": "^8.4.0",
    "typescript": "^5.5.4"
  },
  "publishConfig": {
    "access": "public"
  }
}
