{
  "name": "@arron/react-view",
  "version": "0.0.1",
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./dist/styles.css"
  },
  "scripts": {
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build:css": "arron-tailwind -c tailwind.config.ts -i ./src/tailwind.css -o ./dist/styles.css",
    "dev:css": "arron-tailwind -c tailwind.config.ts -i ./src/tailwind.css -o ./dist/styles.css --watch",
    "build": "pnpm run lint && pnpm run typecheck && pnpm run build:css && tsup",
    "dev": "tsup --watch"
  },
  "dependencies": {
    "@arron/ui": "workspace:*",
    "@scena/react-ruler": "^0.19.0",
    "react-infinite-viewer": "^0.28.1",
    "react-zoom-pan-pinch": "^4.0.3",
    "react-moveable": "^0.56.0",
    "react-selecto": "^1.26.3",
    "rxjs": "^7.8.2",
    "react": "^19",
    "immer": "^11.0.1",
    "infinite-viewer": "^0.29.1",
    "echarts": "^6.0.0",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.2",
    "@arron/eslint-config": "workspace:*",
    "@types/use-sync-external-store": "^1.5.0",
    "@arron/typescript-config": "workspace:*",
    "@arron/tailwind": "workspace:*",
    "eslint": "^8.57.0",
    "typescript": "^5.5.4"
  }
}
