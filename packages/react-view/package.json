{
  "name": "@arronqzy/react-view",
  "version": "1.0.17",
  "files": [
    "src",
    "dist",
    "readme.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./dist/styles.css"
  },
  "scripts": {
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build:css": "arronqzy-tailwind -c tailwind.config.ts -i ./src/tailwind.css -o ./dist/styles.css",
    "dev:css": "arronqzy-tailwind -c tailwind.config.ts -i ./src/tailwind.css -o ./dist/styles.css --watch",
    "build": "pnpm run lint && pnpm run typecheck && pnpm run build:css && tsup",
    "dev": "tsup --watch"
  },
  "dependencies": {
    "@arronqzy/ui": "workspace:*",
    "@arronqzy/blueprint-dsl": "workspace:*",
    "@arronqzy/i18n": "workspace:*",
    "@arronqzy/react-blueprint": "workspace:*",
    "@arronqzy/rx-store": "workspace:*",
    "@arronqzy/view-scene3d": "workspace:*",
    "@arronqzy/view-table": "workspace:*",
    "@arronqzy/webllm-assistant": "workspace:*",
    "@scena/react-ruler": "^0.19.0",
    "@tanstack/react-virtual": "^3.13.2",
    "react-infinite-viewer": "^0.28.1",
    "react-moveable": "^0.56.0",
    "react-selecto": "^1.26.3",
    "rxjs": "^7.8.2",
    "react": "^19",
    "dayjs": "^1.11.13",
    "immer": "^11.0.1",
    "infinite-viewer": "^0.29.1",
    "echarts": "^6.0.0",
    "uuid": "^13.0.0",
    "@uiw/react-codemirror": "^4.23.8",
    "@codemirror/lang-json": "^6.0.1",
    "@codemirror/theme-one-dark": "^6.1.2",
    "@codemirror/view": "^6.36.2"
  },
  "devDependencies": {
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.2",
    "@arronqzy/eslint-config": "workspace:*",
    "@types/use-sync-external-store": "^1.5.0",
    "@arronqzy/typescript-config": "workspace:*",
    "@arronqzy/tailwind": "workspace:*",
    "eslint": "^8.57.0",
    "typescript": "^5.5.4"
  }
}
