{
  "name": "@arronqzy/vue-blueprint",
  "version": "0.1.3",
  "description": "Vue 3 blueprint editor for Abuilder (Vue Flow + Ant Design Vue)",
  "license": "MIT",
  "type": "module",
  "files": [
    "src",
    "dist"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./blueprint.css": "./src/blueprint.css"
  },
  "scripts": {
    "lint": "eslint \"src/**/*.{ts,vue}\"",
    "typecheck": "vue-tsc -p tsconfig.json --noEmit",
    "build": "pnpm run typecheck"
  },
  "dependencies": {
    "@arronqzy/blueprint-dsl": "workspace:*",
    "@arronqzy/i18n": "workspace:*",
    "@arronqzy/vue-rx-store": "workspace:*",
    "@vue-flow/core": "^1.41.2",
    "@vue-flow/background": "^1.3.2",
    "@vue-flow/controls": "^1.1.2",
    "ant-design-vue": "^4.2.6",
    "dayjs": "^1.11.13",
    "vue": "^3.5.13"
  },
  "peerDependencies": {
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "@arronqzy/eslint-config": "workspace:*",
    "@arronqzy/typescript-config": "workspace:*",
    "@vitejs/plugin-vue": "^5.2.1",
    "eslint": "^8.57.0",
    "typescript": "^5.5.4",
    "vue-tsc": "^2.2.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
