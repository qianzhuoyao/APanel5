{
  "name": "@arronqzy/abuilder",
  "version": "1.1.28",
  "description": "Abuilder 可视化编辑器 — 安装后即可通过 <App /> 渲染完整应用",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/styles.css",
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js",
      "require": "./dist/vite.cjs",
      "default": "./dist/vite.js"
    }
  },
  "scripts": {
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "typecheck": "tsc -p tsconfig.json --noEmit --skipLibCheck",
    "build:css": "node ./scripts/build-css.mjs",
    "build:js": "tsup && cp src/vite.d.ts dist/vite.d.ts && cp src/vite.d.ts dist/vite.d.cts",
    "build": "pnpm run build:js && pnpm run build:css",
    "prepublishOnly": "pnpm run build",
    "dev": "tsup --watch"
  },
  "dependencies": {
    "@arronqzy/blueprint-dsl": "workspace:*",
    "@arronqzy/i18n": "workspace:*",
    "@arronqzy/react-blueprint": "workspace:*",
    "@arronqzy/react-view": "workspace:*",
    "@arronqzy/rx-store": "workspace:*",
    "@arronqzy/ui": "workspace:*",
    "@arronqzy/webllm-assistant": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@arronqzy/eslint-config": "workspace:*",
    "@arronqzy/typescript-config": "workspace:*",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.2",
    "@xyflow/react": "^12.9.3",
    "eslint": "^8.57.0",
    "postcss": "^8.4.49",
    "postcss-import": "^16.1.0",
    "tsup": "^8.4.0",
    "typescript": "^5.5.4"
  },
  "publishConfig": {
    "access": "public"
  }
}
