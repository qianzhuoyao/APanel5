{
  "name": "@arronqzy/abuilder-vue",
  "version": "0.1.29",
  "description": "Abuilder Vue 3 入口：通过 Veaury 包装 React 版 @arronqzy/abuilder",
  "license": "MIT",
  "type": "module",
  "files": [
    "src",
    "dist"
  ],
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "lint": "eslint \"src/**/*.{ts,vue}\"",
    "typecheck": "vue-tsc -p tsconfig.json --noEmit",
    "build": "pnpm run typecheck"
  },
  "dependencies": {
    "@arronqzy/abuilder": "workspace:*",
    "@arronqzy/i18n": "workspace:*",
    "veaury": "^2.6.3"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18",
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "@arronqzy/eslint-config": "workspace:*",
    "@arronqzy/typescript-config": "workspace:*",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-vue": "^5.2.1",
    "eslint": "^8.57.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "typescript": "^5.5.4",
    "vue": "^3.5.13",
    "vue-tsc": "^2.2.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
